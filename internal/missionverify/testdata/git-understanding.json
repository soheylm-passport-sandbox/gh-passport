    "activity": {
      "questions": [
        {
          "id": "commit_snapshot",
          "type": "single",
          "prompt": "You stage a note, then save another correction without staging again. You commit. Which version is recorded?",
          "options": [
            {
              "id": "saved",
              "label": "The latest saved version, including the correction."
            },
            {
              "id": "staged",
              "label": "The version you staged, without the later correction."
            },
            {
              "id": "remote",
              "label": "The version currently on GitHub."
            }
          ],
          "answer": [
            "staged"
          ],
          "critical": true,
          "feedback": "A commit records the staged version. To include a later saved correction, stage the note again and inspect git diff --cached before committing."
        },
        {
          "id": "share_commit",
          "type": "single",
          "prompt": "Your draft PR is open. You make another commit on the same practice branch, but have not pushed. What does its Files changed page show?",
          "options": [
            {
              "id": "latest",
              "label": "The new local commit, because the PR is already open."
            },
            {
              "id": "merged",
              "label": "The new commit merged into main."
            },
            {
              "id": "published",
              "label": "The previously pushed change; the new commit is still on your computer."
            }
          ],
          "answer": [
            "published"
          ],
          "critical": true,
          "feedback": "An open PR compares the GitHub branch with main. Push the same practice branch to share your new commit, then inspect the updated PR diff. Neither committing nor pushing merges it."
        },
        {
          "id": "review_correction",
          "type": "single",
          "prompt": "Someone reviewing your draft PR spots an unclear sentence. You agree and save a correction in the same practice folder. How do you update that PR?",
          "options": [
            {
              "id": "amend",
              "label": "Review and stage the correction, commit and push the same branch; inspect the updated draft PR."
            },
            {
              "id": "new_pr",
              "label": "Open another PR; the first one cannot receive later changes."
            },
            {
              "id": "merge",
              "label": "Merge the draft PR first, then correct main."
            }
          ],
          "answer": [
            "amend"
          ],
          "critical": true,
          "feedback": "A PR follows its source branch. Review and commit the correction on the same practice branch, then push and inspect the updated diff. Keep this exercise PR open in draft; do not merge it."
        }
      ]
    }
  },
