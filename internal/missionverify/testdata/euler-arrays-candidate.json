    "activity": {
      "kind": "repository_task",
      "machine": "local",
      "shells": [
        "powershell",
        "zsh",
        "bash"
      ],
      "action": "Correct the fictional Slurm array practice file, add a concurrency cap, and make every task log name unique.",
      "expected_result": "The checker accepts ten tasks with a concurrency cap of one and unique logs; no command submits the practice file to Euler.",
      "questions": [
        {
          "id": "combined_peak",
          "type": "single",
          "critical": true,
          "prompt": "The proposed array has 12 tasks, cap 3, 2 CPUs per task and 3 GiB per CPU. Another job holds 2 CPUs and 5 GiB. What is the maximum combined demand?",
          "options": [
            {
              "id": "combined",
              "label": "8 CPUs and 23 GiB."
            },
            {
              "id": "all_tasks",
              "label": "26 CPUs and 77 GiB."
            },
            {
              "id": "array_only",
              "label": "6 CPUs and 18 GiB."
            },
            {
              "id": "per_task",
              "label": "8 CPUs and 14 GiB."
            }
          ],
          "answer": [
            "combined"
          ],
          "feedback": "Count at most 3 array tasks: 3 x 2 = 6 CPUs and 3 x 2 x 3 = 18 GiB. Add the other job: 8 CPUs and 23 GiB. The range does not make all 12 tasks run together."
        },
        {
          "id": "budget_cap",
          "type": "single",
          "critical": true,
          "prompt": "An array has 12 tasks, 2 CPUs per task and 3 GiB per CPU. Another job holds 2 CPUs and 5 GiB. Under a fictional combined budget of 10 CPUs and 20 GiB, what is the largest cap that fits both limits?",
          "options": [
            {
              "id": "cap_two",
              "label": "Cap 2: 6 CPUs and 17 GiB combined."
            },
            {
              "id": "cap_three",
              "label": "Cap 3: 8 CPUs and 23 GiB combined."
            },
            {
              "id": "cap_four",
              "label": "Cap 4: 10 CPUs and 29 GiB combined."
            },
            {
              "id": "contradiction",
              "label": "Cap 3: 8 CPUs and 17 GiB combined."
            }
          ],
          "answer": [
            "cap_two"
          ],
          "feedback": "Each array task needs 2 CPUs and 6 GiB. After the other job, 8 CPUs and 15 GiB remain in the fictional budget. Cap 2 fits (6 CPUs, 17 GiB combined); cap 3 exceeds memory (23 GiB). Check both limits, not only CPU."
        },
        {
          "id": "node_memory",
          "type": "single",
          "critical": true,
          "prompt": "A 12-task array is capped at 3. Each task uses one node, 2 CPUs and --mem=3G instead of --mem-per-cpu=3G. Another job holds 2 CPUs and 5 GiB. What is the combined peak request?",
          "options": [
            {
              "id": "node_total",
              "label": "The combined request becomes 8 CPUs and 14 GiB, within the fictional 10 CPU / 20 GiB budget."
            },
            {
              "id": "unchanged",
              "label": "It stays 8 CPUs and 23 GiB because memory is always per CPU."
            },
            {
              "id": "omit_job",
              "label": "It becomes 6 CPUs and 9 GiB; the array cap includes the other job."
            }
          ],
          "answer": [
            "node_total"
          ],
          "feedback": "--mem requests memory per node. With one node per array task here, 3 tasks request 3 x 3 = 9 GiB, plus the other job: 14 GiB. CPU stays 3 x 2 + 2 = 8. This is a planning comparison, not evidence that 3 GiB would be sufficient for a real program."
        }
      ],
      "recipe": {
        "intro": "The supplied file is deliberately unsafe. Edit it locally and never submit it to Euler.",
        "steps": [
